# LocalStack Community endpoint. Leave empty to use real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

S3_BUCKET=rag-docs
OPENSEARCH_DOMAIN=rag-vectors
OPENSEARCH_INDEX=rag-chunks

# local = sentence-transformers; bedrock = Titan Embed via bedrock-runtime
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIM=384
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIM=1024

# ollama = local chat model; bedrock = Converse API
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
BEDROCK_LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
